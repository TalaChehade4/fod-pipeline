# Copy this file to .env and fill in real values for your AWS account.
# .env is gitignored - never commit real ARNs, bucket names, or account IDs.

# --- AWS / SageMaker ---
AWS_REGION=us-east-1
SAGEMAKER_ROLE_ARN=arn:aws:iam::<account-id>:role/service-role/<your-execution-role>
S3_BUCKET=<your-bucket-name>

# Root prefix under S3_BUCKET where this project's inputs/outputs live.
S3_PROJECT_PREFIX=fod-pipeline

# --- Model weights (local paths, used for local inference) ---
YOLO_WEIGHTS_PATH=best.pt
MOBILECLIP_WEIGHTS_PATH=mobileclip_s0.pt
MOBILECLIP_MODEL_NAME=mobileclip_s0

# --- SageMaker instance sizing (optional overrides) ---
SAGEMAKER_EMBEDDING_INSTANCE_TYPE=ml.g5.xlarge
SAGEMAKER_TRAINING_INSTANCE_TYPE=ml.g5.xlarge
SAGEMAKER_TESTING_INSTANCE_TYPE=ml.g5.xlarge
